import sys

tpl = (1, 2, 4, 8, 16, 32)
lst = [1, 2, 4, 8, 16, 32]
st = set(lst)
dct = {0 : 1, 1 : 2, 2 : 4, 3 : 8, 4 : 16, 5 : 32}

print("dct element")
print(dct[4])

print("compare sys,getsizeof()")
print(f" dictionary: {sys.getsizeof(dct)}")
print(f" tuple: {sys.getsizeof(tpl)}")
print(f" set: {sys.getsizeof(st)}")
print(f" list: {sys.getsizeof(lst)}")